APP_NAME=Bit2Kwacha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bit2kwacha
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_VERSION=v19.0
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your_business_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_access_token
# Bitcoin Conversion Rates
BITCOIN_CONVERSION_RATE=0.023
BITCOIN_SERVICE_FEE_RATE=0.08
BITCOIN_BUY_NETWORK_FEE=5
BITCOIN_SELL_NETWORK_FEE=400
EXCHANGE_RATES_TOKEN=
BALANCE_CHECK_TOKEN=

OPENNODE_API_KEY=""
OPENNODE_WITHDRAWAL_API_KEY=""
OPENNODE_BASE_URI="api.opennode.com/v1"
OPENNODE_BASE_URI_FOR_WITHDRAWAL="api.opennode.com/v2"
OPENNODE_WEBHOOK_MOBILE_MONEY=""
OPENNODE_WEBHOOK_BANK_TRANSFER=""
OPENNODE_WEBHOOK_WITHDRAWAL_CALLBACK=""
OPENNODE_WEBHOOK_AIRTIME=""

LENCO_TOKEN=""
LENCO_BASE_URI="https://api.lenco.co/access/v2"
LENCO_WALLET_UUID=""
LENCO_PUBLIC_KEY=""

# Optional public URL for OpenNode success redirects (required when APP_URL is localhost)
OPENNODE_SUCCESS_URL=""

# Africa's Talking (Airtime)
AT_USERNAME=""
AT_API_KEY=""
AT_BASE_URI="https://api.africastalking.com/version1"
